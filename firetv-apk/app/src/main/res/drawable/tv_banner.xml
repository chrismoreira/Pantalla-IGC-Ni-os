            android:src="@drawable/igc_logo_blanco" />
    </item>
    <item
        android:height="14dp"
        android:gravity="bottom">
        <shape android:shape="rectangle">
            <solid android:color="#4DB8AF" />
        </shape>
    </item>
</layer-list>
